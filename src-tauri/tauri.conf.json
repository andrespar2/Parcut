{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ParCut",
  "version": "1.0.0",
  "identifier": "com.andrespar2.parcut",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ParCut",
        "label": "main",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 660,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#07080c",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/**/*", "$APPDATA/**/*", "$LOCALDATA/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "andrespar2",
    "copyright": "© 2026 andrespar2",
    "category": "Video",
    "shortDescription": "Divide y publica videos en clips",
    "longDescription": "ParCut importa o descarga videos, los divide automáticamente en clips por duración y los publica de forma secuencial en YouTube, Facebook y TikTok.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/ffmpeg/": "ffmpeg/",
      "binaries/yt-dlp.exe": "yt-dlp/yt-dlp.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
